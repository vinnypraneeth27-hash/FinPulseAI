# Configure these in Netlify; keep real values out of repository files.
# The URL and anon/publishable key are public browser settings.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional replacement for SUPABASE_ANON_KEY:
SUPABASE_PUBLISHABLE_KEY=
# Server-only: never expose this through public-config.
SUPABASE_SERVICE_ROLE_KEY=
